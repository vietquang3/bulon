name: Build IPA

on:
  push:
    branches: [main, master]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@v4

      - name: Cài XcodeGen
        run: brew install xcodegen

      - name: Kiểm tra file trong repo
        run: |
          echo "=== ios/ ==="
          ls -la ios || true
          echo "=== ios/BoxController/ ==="
          ls -la ios/BoxController || true
          echo "=== project.yml ==="
          cat ios/project.yml || true

      - name: Sinh project Xcode
        working-directory: ios
        run: xcodegen generate 2>&1 | tee xcodegen.log

      - name: Liệt kê scheme
        working-directory: ios
        run: |
          ls -la
          xcodebuild -list -project BoxController.xcodeproj 2>&1 | tee list.log || true

      - name: Build (không ký)
        working-directory: ios
        run: |
          set -o pipefail
          xcodebuild \
            -project BoxController.xcodeproj \
            -scheme BoxController \
            -configuration Release \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
            build 2>&1 | tee build.log

      - name: Đóng gói .ipa
        working-directory: ios
        run: |
          APP=$(find build/Build/Products -maxdepth 3 -name "BoxController.app" | head -1)
          echo "App: $APP"
          rm -rf Payload BoxController.ipa
          mkdir Payload
          cp -R "$APP" Payload/
          zip -qry BoxController.ipa Payload
          ls -lh BoxController.ipa

      - name: Tải file .ipa lên (tab Actions -> Artifacts)
        uses: actions/upload-artifact@v4
        with:
          name: BoxController-ipa
          path: ios/BoxController.ipa

      - name: Đính kèm vào Release (khi đẩy tag v*)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: ios/BoxController.ipa

      - name: Lưu log nếu build lỗi
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: build-log
          path: |
            ios/build.log
            ios/xcodegen.log
            ios/list.log
